# Supabase - Copia este archivo como .env y completa los valores
# Obtén estas credenciales en: https://app.supabase.com → tu proyecto → Settings → API

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Formulario para agregar partidos de eliminación directa (/admin/add-match)
# Solo disponible si es exactamente "true". Cualquier otro valor lo deshabilita.
VITE_ENABLE_ADD_MATCH_FORM=false
